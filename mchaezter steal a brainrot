------------------------------------------------
-- 🧠 STUDS ESP SYSTEM (Now Persistent)
------------------------------------------------
local studsESPEnabled = false
local espCache = {}

local function createESP(plr)
	if plr == LocalPlayer then return end
	if not plr.Character or not plr.Character:FindFirstChild("Head") then return end
	if plr.Character.Head:FindFirstChild("StudsESP") then return end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StudsESP"
	billboard.Size = UDim2.new(0, 120, 0, 40)
	billboard.AlwaysOnTop = true
	billboard.Adornee = plr.Character.Head
	billboard.Parent = plr.Character.Head

	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextSize = 14
	textLabel.Text = "Loading..."
	textLabel.Parent = billboard

	espCache[plr] = textLabel
end

local function removeESP(plr)
	if plr.Character and plr.Character:FindFirstChild("Head") then
		local esp = plr.Character.Head:FindFirstChild("StudsESP")
		if esp then esp:Destroy() end
	end
	espCache[plr] = nil
end

local function toggleStudsESP(state)
	studsESPEnabled = state

	if state then
		-- Enable ESP for all players
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				createESP(plr)
			end
		end

		-- Auto add ESP when new player joins
		Players.PlayerAdded:Connect(function(plr)
			plr.CharacterAdded:Connect(function()
				task.wait(1)
				if studsESPEnabled then
					createESP(plr)
				end
			end)
		end)

		-- Reapply ESP when existing players respawn
		for _, plr in ipairs(Players:GetPlayers()) do
			plr.CharacterAdded:Connect(function()
				task.wait(1)
				if studsESPEnabled then
					createESP(plr)
				end
			end)
		end

		-- Constant update
		RunService.RenderStepped:Connect(function()
			if not studsESPEnabled then return end
			for plr, label in pairs(espCache) do
				if plr.Character and plr.Character:FindFirstChild("Head") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
					local dist = (LocalPlayer.Character.Head.Position - plr.Character.Head.Position).Magnitude
					label.Text = string.format("%s\n%.0f studs", plr.Name, dist)
				end
			end
		end)

		Notify("Studs ESP", "Enabled (Persistent)")
	else
		for plr in pairs(espCache) do
			removeESP(plr)
		end
		espCache = {}
		Notify("Studs ESP", "Disabled")
	end
end

------------------------------------------------
-- 🌌 MID AIR WALK
------------------------------------------------
local airWalkEnabled = false
local platform

local function toggleAirWalk(state)
	airWalkEnabled = state
	if state then
		platform = Instance.new("Part")
		platform.Size = Vector3.new(6, 1, 6)
		platform.Anchored = true
		platform.Transparency = 1
		platform.Parent = Workspace

		RunService.Heartbeat:Connect(function()
			if platform and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				platform.Position = LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0, 4, 0)
			end
		end)
		Notify("Mid Air Walk", "Enabled")
	else
		if platform then platform:Destroy() end
		Notify("Mid Air Walk", "Disabled")
	end
end

